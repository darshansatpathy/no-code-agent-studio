# Copy to .env. Everything is optional.

# Where versions, environments, audit and run checkpoints live: memory | sqlite | postgres
STUDIO_STORE=memory
# STUDIO_SQLITE_PATH=studio.db
# STUDIO_DATABASE_URL=postgresql://studio:secret@localhost:5432/studio

# Publish every spec in a folder at start-up, then promote each agent's latest version
# through these environments (the normal gates apply).
# STUDIO_BOOTSTRAP_DIR=agents
# STUDIO_BOOTSTRAP_PROMOTE=dev,staging,prod

# Shared secret the gateway sends as "Authorization: Bearer ...". Unset = development mode.
# STUDIO_SERVICE_TOKEN=

# Only for classify/generate nodes with method: llm (any OpenAI-compatible endpoint)
# STUDIO_LLM_BASE_URL=https://api.openai.com/v1
# STUDIO_LLM_MODEL=gpt-4o-mini
# STUDIO_LLM_API_KEY=

STUDIO_LOG_LEVEL=INFO
